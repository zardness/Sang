# Neon 연결 문자열 (core, rag 스키마에 SELECT 권한만 있는 읽기 전용 계정 권장)
DATABASE_URL=postgresql://agent_reader:비밀번호@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 없으면 템플릿 작성기로 동작 (자유 질문만 불가)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
VERIFY_RETRIES=2
SQL_ROW_LIMIT=200
STATEMENT_TIMEOUT_MS=15000
